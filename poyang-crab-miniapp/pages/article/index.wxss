.article {
  background: #fff;
  padding: 32rpx 32rpx 60rpx;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.meta {
  margin: 16rpx 0 24rpx;
}

.cover {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.rich {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text);
}
