.page {
  padding-bottom: 24rpx;
}

.search-bar {
  background: var(--brand);
  padding: 20rpx 24rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 68rpx;
}

.search-icon {
  color: var(--text-sub);
  font-size: 24rpx;
  margin-right: 12rpx;
}

.search-input input {
  flex: 1;
  font-size: 26rpx;
}

.category-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
}

.category-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: var(--text);
  background: #F5F6F8;
  border-radius: 999rpx;
}

.category-item.active {
  background: var(--brand);
  color: #fff;
}

.live-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0B3D91, #2A6BD4);
  color: #fff;
}

.live-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 8rpx 0;
}

.live-card .text-sub {
  color: rgba(255, 255, 255, 0.85);
}

.live-right {
  background: #fff;
  color: var(--brand);
  border: none;
  padding: 8rpx 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 12rpx;
}

.product-card {
  width: 50%;
  padding: 12rpx;
}

.product-card .product-image {
  width: 100%;
  height: 330rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: #EDEDED;
}

.product-body {
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  padding: 16rpx;
}

.product-name {
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 72rpx;
}

.product-tags {
  margin: 8rpx 0;
}

.product-tags .tag {
  margin-right: 8rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.article-block {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.article-item {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 2;
}
