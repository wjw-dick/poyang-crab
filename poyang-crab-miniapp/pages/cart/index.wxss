.cart-item {
  display: flex;
  position: relative;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #C8CDD6;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  align-self: center;
}

.check.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.cart-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #EDEDED;
  flex-shrink: 0;
}

.cart-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-name {
  font-size: 28rpx;
  line-height: 1.4;
}

.cart-bottom {
  margin-top: 12rpx;
}

.remove {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 56rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #F5F6F8;
}

.stepper-value {
  width: 72rpx;
  text-align: center;
  font-size: 26rpx;
}

.footer-bar .check {
  margin-right: 12rpx;
}

.all-label {
  font-size: 26rpx;
}

.total {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.checkout-btn {
  width: 220rpx;
  margin: 0;
}

.footer-placeholder {
  height: 140rpx;
}

.go-shopping {
  margin-top: 32rpx;
  width: 320rpx;
}
