.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 56rpx;
  color: #DCE0E8;
  margin-right: 16rpx;
}

.star.active {
  color: #FFB020;
}

.score-text {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-left: 12rpx;
}

.content {
  width: 100%;
  min-height: 220rpx;
  font-size: 27rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.image-item,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 30rpx;
}

.image-add {
  border: 1rpx dashed #C8CDD6;
  color: #C8CDD6;
  font-size: 60rpx;
  text-align: center;
  line-height: 156rpx;
  background: #FAFBFC;
}

.footer-placeholder {
  height: 140rpx;
}

.submit-btn {
  width: 100%;
  margin: 0;
}
