.search-bar {
  background: var(--brand);
  padding: 20rpx 24rpx;
}

.search-input {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  height: 68rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

.search-input input {
  flex: 1;
  font-size: 26rpx;
}

.product-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.product-head {
  align-items: flex-start;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #EDEDED;
  flex-shrink: 0;
}

.product-info {
  margin-left: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  max-width: 380rpx;
}

.toggle {
  font-size: 26rpx;
  color: var(--brand);
  flex-shrink: 0;
}

.sku-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 8rpx;
}

.sku-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sku-item:last-child {
  border-bottom: none;
}

.sku-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #EDEDED;
  flex-shrink: 0;
}

.sku-body {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.sku-right {
  text-align: right;
  margin-left: 12rpx;
}

.add-btn {
  font-size: 22rpx;
  line-height: 2.1;
  padding: 0 20rpx;
  margin-top: 8rpx;
}

.loading {
  text-align: center;
  padding: 24rpx 0;
}

.draft-info {
  flex: 1;
  font-size: 26rpx;
}

.submit-btn {
  width: 220rpx;
  margin: 0;
}
