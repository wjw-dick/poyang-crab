<view class="page">
  <block wx:if="{{channel}}">
    <!-- 渠道商头部 -->
    <view class="header">
      <view class="row-between">
        <view>
          <view class="channel-name">{{channel.channelName}}</view>
          <view class="channel-no">编号：{{channel.channelNo || '—'}}</view>
        </view>
        <view class="status-tag">{{statusText}}</view>
      </view>
      <view class="header-metrics">
        <view class="metric">
          <view class="metric-value">¥{{usedQuotaText}}</view>
          <view class="metric-label">已用额度</view>
        </view>
        <view class="metric">
          <view class="metric-value">¥{{creditQuotaText}}</view>
          <view class="metric-label">授信额度</view>
        </view>
        <view class="metric">
          <view class="metric-value">¥{{pendingCommissionText}}</view>
          <view class="metric-label">待结算佣金</view>
        </view>
      </view>
      <view class="quota-bar">
        <view class="quota-fill" style="width: {{quotaPercent}}%"></view>
      </view>
      <view class="row-between quota-text" bindtap="onQuotaDetail">
        <text>额度使用率 {{quotaPercent}}%</text>
        <text>额度明细 ></text>
      </view>
    </view>

    <!-- 分佣比例 -->
    <view class="card">
      <view class="row-between">
        <view>
          <view class="text-sub">我的分佣比例</view>
          <view class="rate">{{commissionRateText}}</view>
        </view>
        <view>
          <view class="text-sub">转介绍返佣比例</view>
          <view class="rate">{{referralRateText}}</view>
        </view>
        <view>
          <view class="text-sub">批发起订量</view>
          <view class="rate">{{overview.minOrderQty || 10}} 件</view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-grid">
      <view
        wx:for="{{quickEntries}}"
        wx:key="key"
        class="quick-item"
        data-url="{{item.url}}"
        bindtap="onEntryTap"
      >
        <view class="quick-label">{{item.label}}</view>
        <view class="text-sub">{{item.desc}}</view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <view wx:elif="{{loaded}}" class="empty">
    <view>尚未登录或未绑定渠道商账号</view>
    <button class="btn-primary login-btn" bindtap="onLogin">去登录</button>
  </view>
</view>
