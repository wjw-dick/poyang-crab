.header {
  background: linear-gradient(135deg, #8A5A16, #B3822F);
  color: #fff;
  padding: 40rpx 32rpx 32rpx;
}

.channel-name {
  font-size: 38rpx;
  font-weight: 700;
}

.channel-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 8rpx;
}

.status-tag {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.header-metrics {
  display: flex;
  margin-top: 36rpx;
}

.metric {
  flex: 1;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 600;
}

.metric-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 6rpx;
}

.quota-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-top: 28rpx;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
}

.quota-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

.rate {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brand);
  margin-top: 8rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 12rpx;
}

.quick-item {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.quick-item .quick-label {
  font-size: 30rpx;
  font-weight: 600;
}

.quick-item {
  background: transparent;
}

.quick-item > .quick-label,
.quick-item > .text-sub {
  background: #fff;
}

.quick-item .quick-label {
  border-radius: 16rpx 16rpx 0 0;
  padding: 24rpx 24rpx 0;
}

.quick-item .text-sub {
  border-radius: 0 0 16rpx 16rpx;
  padding: 6rpx 24rpx 24rpx;
}

.login-btn {
  margin-top: 32rpx;
  width: 320rpx;
}
