.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 24rpx 0;
  color: var(--text-sub);
}

.tab.active {
  color: var(--brand);
  font-weight: 600;
  border-bottom: 4rpx solid var(--brand);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.period-row {
  margin-bottom: 24rpx;
}

.picker {
  padding: 16rpx 28rpx;
  background: #F5F6F8;
  border-radius: 10rpx;
  font-size: 26rpx;
  min-width: 220rpx;
  text-align: center;
}

.tilde {
  color: var(--text-sub);
}

.create-btn {
  width: 100%;
  margin: 0;
}

.hint {
  margin-top: 16rpx;
  text-align: center;
}

.settlement-item,
.quota-item {
  font-size: 27rpx;
}

.settle-no {
  font-weight: 600;
}

.status {
  color: var(--brand);
  font-size: 25rpx;
}

.line {
  margin-top: 8rpx;
}

.amount {
  color: #E4393C;
  font-weight: 600;
}

.confirm-btn {
  font-size: 24rpx;
  line-height: 2.1;
  padding: 0 28rpx;
}

.loading {
  text-align: center;
  padding: 24rpx 0;
}
