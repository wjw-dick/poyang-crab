<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab {{activeStatus === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <view class="card order-card" wx:for="{{orders}}" wx:key="id">
    <view class="row-between">
      <text class="ellipsis" data-no="{{item.orderNo}}" bindtap="onCopyOrderNo">{{item.orderNo}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="row-between order-line">
      <text class="text-sub">共 {{item.totalQty || 1}} 件</text>
      <text class="price">¥{{item.amountText}}</text>
    </view>
    <view class="row-between order-line">
      <text class="text-sub">{{item.timeText}}</text>
      <text class="detail-toggle" data-id="{{item.id}}" bindtap="onToggleDetail">
        {{expandedNo === item.id ? '收起明细' : '查看明细'}}
      </text>
    </view>

    <view wx:if="{{expandedNo === item.id}}" class="detail-list">
      <view class="detail-item row-between" wx:for="{{itemsMap[item.id]}}" wx:for-item="sku" wx:key="id">
        <view class="detail-name ellipsis">{{sku.skuName || sku.productName}}</view>
        <view class="text-sub">¥{{sku.priceText}} x{{sku.qty}}</view>
      </view>
      <view wx:if="{{!itemsMap[item.id]}}" class="text-sub">明细加载中…</view>
    </view>
  </view>

  <view wx:if="{{!orders.length && !loading}}" class="empty">暂无批发订单</view>
  <view wx:if="{{loading}}" class="text-sub loading">加载中…</view>
  <view wx:elif="{{finished && orders.length}}" class="text-sub loading">没有更多了</view>
</view>
