.header {
  background: linear-gradient(135deg, #8A5A16, #B3822F);
  color: #fff;
  padding: 48rpx 32rpx 72rpx;
}

.channel-name {
  font-size: 40rpx;
  font-weight: 700;
}

.channel-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.status-tag {
  padding: 4rpx 18rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.assets {
  display: flex;
  background: #fff;
  margin: -48rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(138, 90, 22, 0.1);
}

.asset-item {
  flex: 1;
  text-align: center;
}

.asset-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
}

.info-row {
  font-size: 27rpx;
  line-height: 2;
}

.link-row {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.link-row:last-child {
  border-bottom: none;
}
