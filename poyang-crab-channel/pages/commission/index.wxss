.summary {
  display: flex;
  background: linear-gradient(135deg, #8A5A16, #B3822F);
  color: #fff;
  padding: 36rpx 0;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 600;
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.tabs {
  display: flex;
  background: #fff;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  padding: 22rpx 0;
  color: var(--text-sub);
}

.tab.active {
  color: var(--brand);
  font-weight: 600;
  border-bottom: 4rpx solid var(--brand);
}

.commission-item {
  font-size: 27rpx;
}

.commission-no {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 12rpx;
}

.amount {
  color: #E4393C;
  font-weight: 600;
}

.line {
  margin-top: 8rpx;
}

.status {
  color: var(--brand);
  font-size: 25rpx;
}

.loading {
  text-align: center;
  padding: 24rpx 0;
}
