.login {
  min-height: 100vh;
  padding: 150rpx 56rpx 0;
  background: linear-gradient(180deg, #8A5A16 0%, #B3822F 40%, #F5F6F8 40%);
}

.logo {
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.slogan {
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.login-box {
  margin-top: 130rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(138, 90, 22, 0.14);
}

.login-btn,
.apply-btn {
  width: 100%;
  margin: 0;
}

.apply-btn {
  margin-top: 24rpx;
}

.tips {
  margin-top: 32rpx;
  line-height: 1.7;
}

.service {
  margin-top: 90rpx;
  text-align: center;
}
