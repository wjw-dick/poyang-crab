# =============================================================
# 部署环境变量模板：cp .env.example .env 后按需修改
# 严禁把 .env 提交到仓库（.gitignore 已忽略）
# =============================================================

# --- 域名与站点 ---
SITE_DOMAIN=xiegongzhu.com
SITE_ADMIN_HOST=admin.xiegongzhu.com

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
MYSQL_DATABASE=poyang_crab
MYSQL_USER=poyang_crab
MYSQL_PASSWORD=ChangeMe_Crab_2026

# --- Redis ---
REDIS_PASSWORD=ChangeMe_Redis_2026

# --- RabbitMQ ---
MQ_USER=poyang_crab
MQ_PASSWORD=ChangeMe_MQ_2026
MQ_VHOST=/poyang_crab

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMe_Minio_2026
MINIO_BUCKET=xiegongzhu

# --- 应用 JWT 密钥（>=32 字节，请务必替换） ---
CRAB_JWT_SECRET=please-change-this-to-a-random-32-bytes-secret

# --- 微信（服务号 / 小程序 / 支付） ---
WX_MP_APPID=
WX_MP_SECRET=
WX_MINI_APPID=
WX_MINI_SECRET=
WX_PAY_MCHID=
WX_PAY_APIV3KEY=

# --- 顺丰丰桥（冷链） ---
SF_PARTNER_ID=
SF_CHECK_WORD=

# --- 端口映射 ---
BACKEND_PORT=8080
ADMIN_PORT=8848
H5_PORT=8849
